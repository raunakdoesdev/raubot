{
	"name": "raubot",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"rules": [{ "type": "Data", "globs": ["**/*.png"] }, { "type": "Text", "globs": ["**/box/boat/*.sh", "**/box/boat/*.service", "**/box/boat/boatd.mjs", "**/*.py"] }],
	"build": { "command": "npx vite build web" },
	"assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": true },
	"routes": [{ "pattern": "raubot.example.com", "custom_domain": true }],
	"vars": { "PROVIDER": "openrouter",
		"MODEL": "anthropic/claude-opus-5.5", "MAIN_MODEL": "anthropic/claude-opus-5.5", "COMPACT_MODEL": "z-ai/glm-5.3-flash", "EXECUTOR_URL": "https://v2.executor.sh/mcp", "PUBLIC_URL": "https://raubot.example.com",
		"ACCESS_TEAM": "YOUR_ACCESS_TEAM", "ACCESS_AUD": "YOUR_ACCESS_AUD", "BOX_BACKEND": "boat", "BOAT_TEMPLATE": "raubot-box-9875488044" },
	"ai": { "binding": "AI" },
	"version_metadata": { "binding": "VERSION" },
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "raubot" }],
	"durable_objects": { "bindings": [{ "name": "RAUBOT", "class_name": "Raubot" }, { "name": "BOX", "class_name": "Computer" }] },
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true } },
	"containers": [
		{ "name": "raubot-computer", "class_name": "Computer", "scheduling_policy": "durable_object", "images": { "box": { "image": "registry.cloudflare.com/YOUR_CLOUDFLARE_ACCOUNT_ID/raubot-box:YOUR_IMAGE_TAG" } } }
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Raubot"] }, { "tag": "v2", "new_sqlite_classes": ["Box"] }, { "tag": "v3", "new_sqlite_classes": ["Computer"] }, { "tag": "v4", "deleted_classes": ["Box"] }],
	"env": {
		"staging": {
			"routes": [{ "pattern": "raubot-staging.example.com", "custom_domain": true }],
			"vars": { "PROVIDER": "openrouter",
				"MODEL": "anthropic/claude-opus-5.5", "MAIN_MODEL": "anthropic/claude-opus-5.5", "COMPACT_MODEL": "z-ai/glm-5.3-flash", "EXECUTOR_URL": "https://v2.executor.sh/mcp", "PUBLIC_URL": "https://raubot-staging.example.com",
				"ACCESS_TEAM": "YOUR_ACCESS_TEAM", "ACCESS_AUD": "YOUR_ACCESS_AUD",
				"BOX_BACKEND": "boat", "BOAT_TEMPLATE": "raubot-box-9875488044" },
			"ai": { "binding": "AI" },
			"version_metadata": { "binding": "VERSION" },
			"artifacts": [{ "binding": "ARTIFACTS", "namespace": "raubot-staging" }],
			"durable_objects": { "bindings": [{ "name": "RAUBOT", "class_name": "Raubot" }, { "name": "BOX", "class_name": "Computer" }] },
			"containers": [
				{ "name": "raubot-staging-computer", "class_name": "Computer", "scheduling_policy": "durable_object", "images": { "box": { "image": "registry.cloudflare.com/YOUR_CLOUDFLARE_ACCOUNT_ID/raubot-box:YOUR_IMAGE_TAG" } } }
			]
		}
	}
}
