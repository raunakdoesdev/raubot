#!/usr/bin/env bash
# raubot-oidc: Reducto Access agent login for raubot (issuer https://raubot.reducto.ai/s/oidc).
#   raubot-oidc token --audience <host>[/<route>/<id>]     prints a 60s RS256 token (Bearer for curl)
#   raubot-oidc login <host>[/<route>/<id>] [cookie-jar]    exchanges it for an 8h Access cookie (POST /_auth/agent)
# Tokens come from the raubot Worker (POST /s/oidc/token, bearer RAUBOT_OIDC_MINT_KEY from the box env); the signing key never leaves the Worker.
# Never print or log tokens or cookies.
set -euo pipefail
base="${RAUBOT_URL:-https://raubot.reducto.ai}"

token() {
	local aud="$1"
	: "${RAUBOT_OIDC_MINT_KEY:?RAUBOT_OIDC_MINT_KEY not set (the box gets it from the Worker secret OIDC_MINT_KEY)}"
	local out code
	out=$(curl -sS -w '\n%{http_code}' -X POST -H "Authorization: Bearer $RAUBOT_OIDC_MINT_KEY" --get --data-urlencode "audience=$aud" "$base/s/oidc/token")
	code="${out##*$'\n'}"; out="${out%$'\n'*}"
	if [ "$code" != "200" ]; then echo "raubot-oidc: mint failed ($code): $out" >&2; return 1; fi
	printf '%s' "$out" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(JSON.parse(s).token))'
}

case "${1:-}" in
	token)
		shift; aud=""
		while [ $# -gt 0 ]; do case "$1" in --audience) aud="$2"; shift 2;; --audience=*) aud="${1#*=}"; shift;; *) echo "unknown arg $1" >&2; exit 2;; esac; done
		[ -n "$aud" ] || { echo "usage: raubot-oidc token --audience <host>" >&2; exit 2; }
		token "$aud"; echo ;;
	login)
		target="${2:?usage: raubot-oidc login <host>[/<route>/<id>] [cookie-jar]}"
		jar="${3:-$HOME/.reducto-access-cookies.txt}"
		host="${target%%/*}"; path="${target#"$host"}"
		t=$(token "$target")
		body=$(mktemp); trap 'rm -f "$body"' EXIT
		status=$(curl -sS -o "$body" -w '%{http_code}' -c "$jar" -X POST -H "Authorization: Bearer $t" "https://${host}${path}/_auth/agent")
		chmod 600 "$jar" 2>/dev/null || true
		if [ "$status" != "200" ]; then echo "agent login failed ($status): $(cat "$body")" >&2; exit 1; fi
		cat "$body"; echo
		echo "cookie jar: $jar (use: curl -b $jar https://${host}${path}/)" ;;
	*) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
