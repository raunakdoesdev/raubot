[Unit]
Description=raubot box daemon
After=network-online.target raubot-firewall.service
Wants=network-online.target

[Service]
User=user
Environment=HOME=/home/user DISPLAY=:0 XAUTHORITY=/home/user/.Xauthority RAUBOT_CHROME=chrome RAUBOT_DISPLAY=:0 RAUBOT_BW_DIR=/dev/shm/raubot-bw
# /workspace and /scratch live outside what Boat snapshots: /workspace points into /home/user, /scratch stays throwaway.
ExecStartPre=+/bin/sh -c 'ln -sfn /home/user/workspace /workspace && mkdir -p /scratch /home/user/workspace && chown user:user /scratch /home/user/workspace'
ExecStart=/usr/local/bin/node /opt/raubot/boatd.mjs
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
