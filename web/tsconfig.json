{
	"compilerOptions": {
		"target": "es2023", "module": "es2022", "moduleResolution": "bundler", "strict": true, "noEmit": true, "skipLibCheck": true,
		"lib": ["es2023", "dom", "dom.iterable"], "types": ["svelte", "vite/client"], "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "vite.config.ts", "../src/app/ttl.ts"]
}
